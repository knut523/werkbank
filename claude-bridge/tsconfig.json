{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "allowJs": false,
    "strict": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
