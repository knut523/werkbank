# LibreChat-Umgebung der OLAF-Werkbank – OHNE Geheimnisse.
# Geheimnisse (CREDS_KEY, JWT_*, MEILI_MASTER_KEY) stehen in ../.env.local (gitignored,
# erzeugt von scripts/setup.sh). start.sh lädt erst diese Datei, dann .env.local.

HOST=127.0.0.1
PORT=3080
NODE_ENV=production

# Coder-Vorschau-URL: Anmeldung und Cookies laufen über den Proxy.
DOMAIN_CLIENT=https://3080--main--dev--knut.ws.konekto.energy
DOMAIN_SERVER=https://3080--main--dev--knut.ws.konekto.energy
TRUST_PROXY=1
NO_INDEX=true
APP_TITLE=OLAF-Werkbank
HELP_AND_FAQ_URL=/

MONGO_URI=mongodb://127.0.0.1:27017/LibreChat

SEARCH=true
MEILI_HOST=http://127.0.0.1:7700
MEILI_NO_ANALYTICS=true

# Nur der Claude-Code-Endpunkt (custom); keine API-Schlüssel-Endpunkte.
ENDPOINTS=custom
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_KEY=
ASSISTANTS_API_KEY=

# Anmeldung: E-Mail ja (Registrierung nur maxenergy.at/konekto.energy, siehe librechat.yaml),
# keine Social-Logins, kein Mailversand → unbestätigte Adressen zulassen.
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
SESSION_EXPIRY="1000 * 60 * 15"
REFRESH_TOKEN_EXPIRY="(1000 * 60 * 60 * 24) * 7"

# Claude-Code-Züge dauern: Limits großzügig, Moderation aus.
LIMIT_CONCURRENT_MESSAGES=true
CONCURRENT_MESSAGE_MAX=2
LIMIT_MESSAGE_IP=false
LIMIT_MESSAGE_USER=false
BAN_VIOLATIONS=false

DEBUG_LOGGING=true
CONSOLE_JSON=false
DEBUG_CONSOLE=false

# CUSTOM_FOOTER (Links zur Werkbank-Web-App) erzeugt scripts/werkbank.sh up in .env.local, weil die URL je Workspace anders ist.
CUSTOM_FOOTER="OLAF-Werkbank · Pilot · Claude Code unter deinem eigenen Claude-Konto"

# Chats teilen: nur für angemeldete Konten, keine öffentlichen Links (siehe librechat.yaml sharedLinks).
ALLOW_SHARED_LINKS=true
ALLOW_SHARED_LINKS_PUBLIC=false
